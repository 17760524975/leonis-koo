# 生成物（截图 / 临时补丁 / 缓存），不入库
tools/out/
node_modules/
*.log

# 一次性补丁脚本与本地备份
tools/_*
*.bak
*.bak-*

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 音频母带（34MB，本地保留；打包后的 90s/48kbps 版本已入库 assets/audio/）
audio/*.mp3

# 小游戏工程目录里误留的内嵌仓库（2.6MB，克隆时不需要）
miniprogram/.git/

# v0.32 关卡重制的中间产物（参考图裁切、放大图、求解渲染）
tools/alpha/out/
tools/tanref/out/
tools/tanref2/out/
tools/tanref3/out/
tools/tanref*/*.png
tools/tanref*/*.jpg
tools/tanref*/*.npy
tools/tanref*/*.npz

# v0.44 / v0.45 参考图求解的中间产物（遮罩、叠加图、中间 JSON）
# 参考图本身（ref/）入库，out/ 是每次跑脚本都能重新生成的
tools/letters7/out/
tools/figs4/out/

# 生肖反解：本地备份（可由 compact.js 重新生成）
tools/zodiac/*.bak.json
tools/glyph/one.html
tools/glyph/*.bak.json

# 舞者反解：中间渲染与调试图（ref.png 作输入保留入库）
tools/dancer/out/
tools/dancer/d[0-9]*.png
tools/dancer/z*.png
